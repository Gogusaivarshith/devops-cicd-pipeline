pipeline {
    agent any

    environment {
        IMAGE_NAME = "devops-demo"
        IMAGE_TAG = "${BUILD_NUMBER}"
    }

    stages {
        stage('Checkout') {
            steps {
                checkout scm
            }
        }

        stage('Install Dependencies') {
            steps {
                sh 'python3 -m venv .venv'
                sh '. .venv/bin/activate && pip install -r app/requirements.txt'
            }
        }

        stage('Unit Tests') {
            steps {
                sh '. .venv/bin/activate && pytest -q'
            }
        }

        stage('Build Docker Image') {
            steps {
                sh 'docker build -f docker/Dockerfile -t ${IMAGE_NAME}:${IMAGE_TAG} .'
            }
        }

        stage('Deploy to Kubernetes') {
            when {
                expression {
                    return env.DEPLOY_TO_K8S == 'true'
                }
            }
            steps {
                sh 'kubectl apply -k k8s/'
                sh 'kubectl rollout status deployment/devops-demo -n devops-demo --timeout=120s'
            }
        }
    }

    post {
        always {
            junit allowEmptyResults: true, testResults: '**/test-results/*.xml'
            echo "Pipeline completed: ${currentBuild.currentResult}"
        }
    }
}
